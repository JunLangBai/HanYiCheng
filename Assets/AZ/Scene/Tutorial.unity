  tutorialTexts:
  - "\u6311\u6218\u5173\u5361\uFF1A\u5728\u4F1A\u5143\u97F3\u8F85\u97F3\u7684\u57FA\u7840\u4E0A\u7528\u95EF\u5173\u7684\u5F62\u5F0F\u6765\u8003\u8BD5\u5427"
  - "\u70B9\u8BFB\u673A\uFF1A\u5B66\u4F1A\u6700\u57FA\u7840\u5143\u97F3\u8F85\u97F3\u53D1\u97F3\u548C\u57FA\u672C\u6982\u5FF5"
  - "\u573A\u666F\u5BF9\u8BDD\uFF1A\u8DDF\u97E9\u6613\u6210\u7EC3\u7EC3\u73B0\u5B9E\u573A\u666F\u5BF9\u8BDD\u5427\uFF01"
  - "\u8BBE\u7F6E\uFF1A\u53EF\u4EE5\u8C03\u6574\u5E94\u7528\u7684\u4E00\u4E9B\u8BBE\u7F6E"
  - "\u4EE5\u4E0A\u662F\u6BCF\u4E2A\u6309\u94AE\u7684\u529F\u80FD\uFF0C\u73B0\u5728\u5F00\u59CB\u66F4\u6DF1\u5165\u7684\u4E86\u89E3\u4E00\u4E0B\u97E9\u6613\u6210\u5427\uFF01"
  - "\u4F60\u53EF\u4EE5\u968F\u65F6\u968F\u5730\u901A\u8FC7\u63E1\u62F3\u7684\u65B9\u5F0F\u628A\u753B\u9762\u79FB\u52A8\u5230\u773C\u524D\uFF0C\u66F4\u65B9\u4FBF\u7684\u5B66\u4E60\u97E9\u8BED"
  - "\u5B66\u4E60\u97E9\u8BED\u7684\u6B65\u9AA4\u6700\u597D\u662F\u4ECE\u70B9\u8BFB\u673A\u4E86\u89E3\u97E9\u8BED\uFF0C\u518D\u901A\u8FC7\u6311\u6218\u5173\u5361\u5DE9\u56FA\u77E5\u8BC6\uFF01"
  - "\u4F60\u4E5F\u53EF\u4EE5\u5728\u60C5\u666F\u5BF9\u8BDD\u573A\u666F\u4E2D\u8EAB\u4E34\u5176\u5883\u7684\u4F53\u9A8C\u65E5\u5E38\u7528\u8BED\uFF01"
  - "\u795D\u5927\u5BB6\u6709\u4E00\u4E2A\u7F8E\u597D\u7684\u5B66\u4E60\u8FC7\u7A0B\uFF01"
