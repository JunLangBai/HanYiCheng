--- !u!114 &85089182
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 85089178}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 82512133c80960a47af534c318b90c28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  clickButton: {fileID: 85089183}
  displayText: {fileID: 731220639}
  textGroup: {fileID: 731220638}
  displayDuration: 5
  originalTexts:
  - "\u4F60\u597D\u50CF\u662F\u6211\u7684\u5976\u8336\uFF0C\u751C\u5F97\u8BA9\u6211\u6212\u4E0D\u6389~"
  - "\u4F60\u50CF\u6211\u7684\u773C\u955C\uFF0C\u6CA1\u6709\u4F60\uFF0C\u6211\u770B\u4E0D\u6E05\u672A\u6765"
  - "\"\uD654\uC7A5\uC2E4\uC740 \uC5B4\uB514\uC5D0 \uC788\uB098\uC694?\"\u610F\u601D\u662F\u201C\u6D17\u624B\u95F4\u5728\u54EA\u513F?\u201C"
  - "\"\uC624\uB298 \uB0A0\uC528 \uC88B\uB124\uC694.\"\u7684\u610F\u601D\u662F\u201C\u4ECA\u5929\u5929\u6C14\u771F\u597D\u201D"
  - "\u97E9\u8BED\u5206 \u656C\u8BED\uFF08-\uC694/-\uC2B5\uB2C8\uB2E4\uFF09 \u548C
    \u975E\u656C\u8BED\uFF0C\u5BF9\u957F\u8F88\u6216\u964C\u751F\u4EBA\u8BB0\u5F97\u8981\u7528\u656C\u8BED"
  - "\u591A\u52A0\u7EC3\u4E60\u53E3\u8BED\u548C\u542C\u529B\uFF0C\u97E9\u5267\u6216\u7EFC\u827A\u662F\u5F88\u597D\u7684\u5B66\u4E60\u7D20\u6750\uFF01"
  - "\u97E9\u8BED\u52A8\u8BCD\u5728\u53E5\u5C3E\uFF0C\u548C\u4E2D\u6587\u76F8\u53CD\u3002"
  - "\u5BF9\u964C\u751F\u4EBA\u6216\u957F\u8F88\u5FC5\u987B\u7528\u201C-\uC694/-\uC2B5\uB2C8\uB2E4\u201D\uFF0C\u670B\u53CB\u95F4\u7528\u201C-\uC544/\uC5B4\u201D"
  - "\u542C\u4E0D\u61C2\u65F6\u5FAE\u7B11\u8BF4\u201C\uB2E4\uC2DC \uD55C \uBC88 \uB9D0\uC500\uD574
    \uC8FC\uC138\uC694\u201D\uFF08\u8BF7\u518D\u8BF4\u4E00\u904D\uFF09"
  - "\u88AB\u5938\u97E9\u8BED\u597D\u53EF\u4EE5\u8C26\u865A\u7684\u56DE\u7B54\u201C\uC544\uC9C1
    \uBD80\uC871\uD574\uC694\u201D"
  - "\u4F60\u662F\u6211\u7684\u5929\u6C14\u9884\u62A5\uFF0C\u4E00\u51FA\u73B0\u5C31\u6674\u7A7A\u4E07\u91CC\u3002"
  - "\u6211\u89C9\u5F97\u4F60\u4ECA\u5929\u6709\u70B9\u602A\uFF0C\u54EA\u91CC\u602A\u4E86\uFF0C\u602A\u53EF\u7231\u7684\u3002  "
  - "\u4F60\u77E5\u9053\u6211\u6700\u559C\u6B22\u5403\u4EC0\u4E48\u6C34\u679C\u5417?\u4F60\u8FD9\u4E2A\u5F00\u5FC3\u679C\u3002"
  - "\u8D70\u5728\u8DEF\u4E0A\u88AB\u6CE5\u6E85\u4E86\u4E00\u8EAB\uFF0C\u56DE\u53BB\u4E00\u67E5\u624D\u77E5\u9053\u8FD9\u6CE5\u53EB\u505A\u6211\u597D\u60F3\u6CE5"
